# Copy to .env.local and fill in. .env.local is gitignored.
#
# IMPORTANT: every VITE_* variable is inlined into the client bundle at build
# time. These values are readable by anyone who can load the built app.
# Do not put a billable AI key here unless the deployment is private.

# --- Firebase (values from Firebase console > Project settings) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- AI providers (optional; app degrades gracefully without them) ---
VITE_GEMINI_API_KEY=
VITE_COHERE_API_KEY=
